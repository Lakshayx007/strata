# Copy to .env and fill in. .env is git-ignored; never commit it or paste its values anywhere.

# Postgres connection string. Supabase: Project Settings > Database > Connection string > URI,
# then change the scheme to postgresql+psycopg2://
DATABASE_URL=postgresql+psycopg2://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# Secret used to HMAC author names. Generate once with: python -c "import secrets; print(secrets.token_hex(32))"
# Keep it stable (changing it changes every author_hash) and never commit it.
AUTHOR_HASH_SALT=REPLACE_WITH_64_HEX_CHARS

# Reddit app-only, read-only access. Create a "script" app at https://www.reddit.com/prefs/apps;
# the client id is the string under the app name, the secret is labelled "secret". No username/password needed.
REDDIT_CLIENT_ID=YOUR_REDDIT_CLIENT_ID
REDDIT_CLIENT_SECRET=YOUR_REDDIT_CLIENT_SECRET
# Max "load more comments" expansions per submission (each is one API call)
REDDIT_REPLACE_MORE_LIMIT=8

# GitHub classic token with NO scopes selected (public data only, 5,000 req/hour).
# Create at https://github.com/settings/tokens/new and leave every scope box unticked.
STRATA_GITHUB_TOKEN=ghp_YOUR_TOKEN_WITH_NO_SCOPES

# Optional. Stack Exchange app key raises the daily quota from 300 to 10,000.
# Register at https://stackapps.com/apps/oauth/register; leave empty to run unkeyed.
STACKEXCHANGE_KEY=
# Requests/day we allow ourselves when unkeyed (kept under the 300 limit)
SE_DAILY_BUDGET=290
# Complete months of tag counts to collect per tag (one request each)
SE_TAG_COUNT_MONTHS=24

# Earliest post date to collect (YYYY-MM-DD) and cap per search query
STRATA_SINCE=2023-01-01
STRATA_LIMIT_PER_QUERY=500

# 1 allows the headless-browser fallback for JS-rendered vendor pages (needs: pip install playwright)
DOCS_USE_PLAYWRIGHT=0
